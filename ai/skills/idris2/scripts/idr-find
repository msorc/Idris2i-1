#!/bin/sh
# Print the path of the Idris 2 compiler to use, or fail with a hint.
#
# Order: $IDRIS2, build/exec/idris2 of a compiler checkout that contains the
# current directory, idris2 on PATH, ~/.idris2/bin/idris2.

if [ -n "${IDRIS2:-}" ]; then
  echo "$IDRIS2"; exit 0
fi
dir=$(pwd)
while [ "$dir" != / ]; do
  if [ -x "$dir/build/exec/idris2" ] && [ -f "$dir/idris2.ipkg" ]; then
    echo "$dir/build/exec/idris2"; exit 0
  fi
  dir=$(dirname "$dir")
done
if command -v idris2 >/dev/null 2>&1; then
  command -v idris2; exit 0
fi
if [ -x "$HOME/.idris2/bin/idris2" ]; then
  echo "$HOME/.idris2/bin/idris2"; exit 0
fi
echo "idr-find: no idris2 found; set IDRIS2=/path/to/idris2" >&2
exit 1
