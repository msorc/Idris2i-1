(define CoreC-45Directory-n--11848-7809-u--findIpkgFileC-39 (lambda (arg-0 arg-1 ext-0) (let ((act-1 (_PEC-45CoreC-45Directory-PE_listDir_a786a45dc2f4d901 arg-0 ext-0))) (case (vector-ref act-1 0) ((1) (let ((e-2 (vector-ref act-1 1))) (let ((sc1 (DataC-45List-find (lambda (u--f) (PreludeC-45Types-u--C-61C-61_Eq_C-40MaybeC-32C-36aC-41 (force csegen-349) (LibrariesC-45UtilsC-45Path-extension u--f) (box "ipkg"))) e-2))) (if (null? sc1) (let ((sc2 (LibrariesC-45UtilsC-45Path-splitParent arg-0))) (if (null? sc2) '() (let ((e-1 (unbox sc2))) (let ((e-5 (car e-1))) (let ((e-6 (cdr e-1))) (CoreC-45Directory-n--11848-7809-u--findIpkgFileC-39 e-5 (LibrariesC-45UtilsC-45Path-C-60C-47C-62 e-6 arg-1) ext-0)))))) (let ((e-1 (unbox sc1))) (box (cons arg-0 (cons e-1 arg-1)))))))) (else '())))))
