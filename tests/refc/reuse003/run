. ../../testutils.sh

idris2 -o main Main.idr
IDRIS2_REFC_LEAKCHECK=1 $VALGRIND ./build/exec/main 2> leaks.txt
grep "leaked values" leaks.txt | sed 's/,.*//'
fn() { awk -v RS= "/Value \\*Main_$2\\n/ && /\\{/" "build/exec/$1.c"; }
# The uniqueness tests (a cell kept), and the cells freed or released
# because no constructor takes them over: both cells of `merge` and of
# `count` are taken over; `pick` releases one of its two in one branch.
for f in merge count firstOfTwo pick; do
  echo "$f: $(fn main $f | grep -c idris2_isUnique) $(fn main $f | grep -c 'idris2_freeValue\|idris2_removeReuseConstructor')"
done
fn main merge
# one cell of a key at most with the directive
idris2 --directive refc-no-multi-reuse -o main2 Main.idr
$VALGRIND ./build/exec/main2
for f in merge count; do
  echo "$f: $(fn main2 $f | grep -c idris2_isUnique) $(fn main2 $f | grep -c 'idris2_freeValue\|idris2_removeReuseConstructor')"
done
rm -f leaks.txt
