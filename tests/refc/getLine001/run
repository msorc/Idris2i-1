. ../../testutils.sh

idris2i_1 -o main Main.idr

# 2000 numbers after a few lines: UTF-8, CRLF, a line longer than the
# first buffer, an empty line.
{
  echo 2004
  echo "αβγ → ok"
  printf 'crlf\r\n'
  awk 'BEGIN { s = ""; for (i = 0; i < 1000; i++) s = s "x"; print s }'
  echo
  seq 1 2000
} > input

./build/exec/main < input
# Once more under Valgrind, which prints only when it finds an error.
$VALGRIND ./build/exec/main < input | grep '^valgrind:'
# (not under Valgrind: the leak check looks at the pages)
IDRIS2I_1_REFC_LEAKCHECK=1 ./build/exec/main < input 2>&1 >/dev/null | sed 's/,.*//'
rm -f input output.valgrind.refc.log
