. ../../testutils.sh

# Foreign structs (Struct, getField and setField of System.FFI): the C of the
# program defines the structs by the fields of their Idris types, and
# includes the header of the library, which defines structs of the same
# names.

cd ./library/
    make > /dev/null
cd ..

export CFLAGS="-I./library/ ${CFLAGS}"
export LDFLAGS="-L./library/ ${LDFLAGS}"
export LDLIBS="-lstructs"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:./library/"
export DYLD_LIBRARY_PATH="$DYLD_LIBRARY_PATH:./library/"

idris2 -o structs Main.idr

$VALGRIND ./build/exec/structs
# (not under Valgrind: the leak check looks at the pages)
IDRIS2_REFC_LEAKCHECK=1 ./build/exec/structs 2>&1 >/dev/null | sed 's/,.*//'

cd ./library/
    make clean > /dev/null
cd ..
