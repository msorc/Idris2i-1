. ../../testutils.sh

idris2 -o main Main.idr
$VALGRIND ./build/exec/main

# A partial application that is applied once (in one branch, or as the
# argument of another one) is a call: no closure is made for it.
count() {
  for f in oneBranch nested reuseBranch tree lazyClosure; do
    printf '%s %s\n' $f $(awk -v RS= "/Value \\*Main_$f\\n/" build/exec/$1.c | grep -c 'idris2_mkClosure')
  done
}
count main

# Without the rewrite, closures are made, and the program gives the same.
idris2 --directive refc-no-local-closures -o main2 Main.idr
./build/exec/main2
count main2
