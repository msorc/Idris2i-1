. ../../testutils.sh

idris2i_1 -o main Main.idr
$VALGRIND ./build/exec/main

# A partial application that is applied once (in one branch, as the
# argument of another one, or to its missing arguments one at a time) is a
# call: no closure is made for it.
count() {
  for f in oneBranch manyMissing nested reuseBranch tree lazyClosure; do
    printf '%s %s\n' $f $(awk -v RS= "/Value \\*Main_$f\\n/" build/exec/$1.c | grep -c 'idris2i_1_mkClosure')
  done
}
count main

# Without the rewrite, closures are made, and the program gives the same.
idris2i_1 --directive refc-no-local-closures -o main2 Main.idr
./build/exec/main2
count main2
