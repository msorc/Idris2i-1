||| Casting a fraction to a Double gives the Double nearest to it (the even
||| one of two at the same distance), as in the Chez backend: mpq_get_d
||| truncated ("1/10" was 0.09999999999999999).  Halfway cases at 2^53, at
||| the smallest subnormal and at the largest Double, an underflow to -0.0 and
||| overflows.
module Main

import Data.IORef
import Data.String

-- (read at run time: the casts are not folded)
runtime : a -> IO a
runtime x = newIORef x >>= readIORef

zeros : Nat -> String
zeros n = replicate n '0'

main : IO ()
main = do
  ss <- runtime
          ["1/10", "1/5", "-1/10", "+1/10", "2/3", "1/3", "-7/2", "0/7",
           "-0/5", "9007199254740993/1", "9007199254740995/1",
           "18014398509481983/2", "-9007199254740993/1",
           "4940656458412465441765687928682213723651/1" ++ zeros 363,
           "2470328229206232720882843964341106861825/1" ++ zeros 363,
           "2470328229206232720882843964341106861826/1" ++ zeros 363,
           "-1/1" ++ zeros 400, "1" ++ zeros 400 ++ "/1",
           "-1" ++ zeros 400 ++ "/3",
           "",
           "",
           "123456789012345678901234567890/7", "-8347/80462845"]
  for_ ss $ \s => printLn (cast {to = Double} s)
