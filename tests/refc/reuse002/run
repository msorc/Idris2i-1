. ../../testutils.sh

idris2i-1 --directive refc-size-reuse -o main Main.idr
IDRIS2I_1_REFC_LEAKCHECK=1 $VALGRIND ./build/exec/main 2> leaks.txt
grep "leaked values" leaks.txt | sed 's/,.*//'
# Main.turn takes the cell over: the tag is set, the fields are stored
# only where they move.
awk -v RS= '/Value \*Main_turn/' build/exec/main.c
awk -v RS= '/Value \*Main_dupe/' build/exec/main.c
rm -f leaks.txt
