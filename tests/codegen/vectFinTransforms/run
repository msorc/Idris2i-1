. ../../testutils.sh

idris2i_1 --dumpcases Main.cases -o Main Main.idr
./build/exec/Main

# The names of Data.Vect and Data.Fin that each definition calls: the
# run-time versions.  The foldr of Foldable (Vect n) is the foldr of lists
# on the same cells (vectToList is an identity).
for f in Main.useTabulate Main.useRange Main.useVectAllFins Main.useListAllFins \
         Main.useList1AllFins Main.useLength Main.useFoldr Data.Vect.Fin.range \
         Main.useStrengthen Data.Fin.finS Main.usePlus Main.useMult \
         Main.useComplement; do
    printf '%s:' "$f"
    grep "^$f = " Main.cases | sed -e 's/^[^=]*= //' | grep -o "Data\.\(Vect\|Fin\)\.[A-Za-z0-9.]*\|Prelude\.Types\.foldr" | sort -u | tr '\n' ' '
    echo
done
# The dictionary of Num (Fin 5) that main passes to usePoly
printf 'Num (Fin 5) dictionary:'
grep -o 'Main\.usePoly \[.*' Main.cases | grep -o 'Data\.Fin\.[A-Za-z]*Integer' | sort -u | tr '\n' ' '
echo
rm -f Main.cases
