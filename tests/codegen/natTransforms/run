. ../../testutils.sh

idris2i_1 --dumpcases Main.cases -o Main Main.idr
./build/exec/Main

# The names of Data.Nat that each definition calls: the versions on Integer.
# The divisions of Data.Nat (divNatNZ, modNatNZ, and gcd through modNatNZ)
# reach them too.
for f in Main.useLte Main.useGt Main.useMinimum Main.useMaximum Main.usePower \
         "Main.useDiv'" "Main.useMod'" "Main.useDivmod'" Main.useIsLTE \
         Main.useDecEq \
         Data.Nat.divNatNZ Data.Nat.modNatNZ Data.Nat.gcd; do
    printf '%s:' "$f"
    grep "^$f = " Main.cases | sed -e 's/^[^=]*= //' | grep -o "Data\.Nat\.[A-Za-z']*\|Decidable\.Equality\.[A-Za-z]*" | sort -u | tr '\n' ' '
    echo
done
# The dictionary of DecEq Nat that main passes to usePoly
printf 'DecEq Nat dictionary:'
grep -o 'Main\.usePoly \[(%lam {eta:0} (%lam {eta:1} ([A-Za-z.]*' Main.cases | sed -e 's/.*(//'
rm -f Main.cases
