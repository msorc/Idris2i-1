. ../../testutils.sh

# With RefC (under Valgrind when it is installed), then
# the same with Chez and Node.
idris2 --cg refc -p contrib -o ranges Ranges.idr > /dev/null
$VALGRIND ./build/exec/ranges > out
cat out
idris2 --cg chez -p contrib -o ranges-chez Ranges.idr > /dev/null
./build/exec/ranges-chez > out-chez
cmp out out-chez && echo "the same with Chez"
idris2 --cg node -p contrib -o ranges.js Ranges.idr > /dev/null
node ./build/exec/ranges.js > out-node
cmp out out-node && echo "the same with Node"

# The checked reads of RefC stop at a range that is out of the buffer.
idris2 --cg refc -p contrib -o crash Crash.idr > /dev/null
for what in ok byte neg word compare find hash; do
  echo "--- $what"
  # (a range check names the file and line of the runtime that failed)
  ./build/exec/crash $what 2>&1 | sed 's/^assertion failed in .*: \(offset\|len\)/assertion failed: \1/'
done
rm -rf build out out-chez out-node output.valgrind.refc.log
