. ../../testutils.sh

idris2i_1 -o stdin Stdin.idr
printf 'xab\ncdefg\n\nh i\r\nlast' > input.txt
echo "-- pipe"
cat input.txt | ./build/exec/stdin
echo "-- file"
./build/exec/stdin < input.txt
echo "-- main thread"
IDRIS2I_1_MAIN_STACK_SIZE=0 ./build/exec/stdin < input.txt
echo "-- ends with a newline"
printf 'xab\ncdefg\n\nend\n' | ./build/exec/stdin
echo "-- empty"
./build/exec/stdin < /dev/null
rm -f input.txt
