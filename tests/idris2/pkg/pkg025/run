. ../../../testutils.sh

# The executable of a package is compiled again when its main module changed,
# or a C header that it includes (see pkg023 for the rest).
# (A stamp is not written when files were written within the last second, on
# file systems that keep seconds only: wait, so that there is one.)

build() {
  idris2 --build "$@" | grep -v "Building"
}

echo "--- first build"
build exe.ipkg
build/exec/exe

sleep 2
build exe.ipkg > /dev/null

echo "--- nothing changed"
build exe.ipkg
build/exec/exe

echo "--- another main module"
sed -i.bak 's/^main = Bar/main = Foo/' exe.ipkg
build exe.ipkg
build/exec/exe

sleep 2
build exe.ipkg > /dev/null

echo "--- nothing changed again"
build exe.ipkg

echo "--- the main module back"
mv exe.ipkg.bak exe.ipkg
build exe.ipkg
build/exec/exe

export IDRIS2_CPPFLAGS="-Iinclude"

echo "--- a header"
build hdr.ipkg
build/exec/hdr

sleep 2
build hdr.ipkg > /dev/null

echo "--- nothing changed"
build hdr.ipkg

echo "--- a header that the header includes changed"
cp include/factor.h include/factor.h.bak
printf '#define STAMP_FACTOR 3\n' > include/factor.h
build hdr.ipkg
build/exec/hdr

mv include/factor.h.bak include/factor.h
