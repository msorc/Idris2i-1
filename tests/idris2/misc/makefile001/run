. ../../../testutils.sh

# What the Makefile of the repository passes to the compilers that it runs,
# with `make -n` in a copy of it (to which a custom.mk can be added), and
# MAKE=echo, so that the makes that it runs are shown and not run.  A fake
# Homebrew has the gmp.h that config.mk looks for: its directories must reach
# the boot compiler that builds the compiler with RefC, and the compiler under
# test that builds the test runner and runs the tests, which read them from
# the environment only.

root=$(cd ../../../.. && pwd)
mkdir -p build/top build/brew/include build/brew/lib
cp "$root/Makefile" "$root/config.mk" build/top/
: > build/brew/include/gmp.h
brew=$(cd build/brew && pwd)

# Only what this test sets, not what the make that runs the tests passes on.
unset MAKEFLAGS MFLAGS MAKELEVEL CPPFLAGS LDFLAGS IDRIS2_CPPFLAGS IDRIS2_LDFLAGS \
      IDRIS2_CG TEST_PREFIX TEST_IDRIS2_SUPPORT_DIR IDRIS2_SUPPORT_DIR
make=${MAKE:-make}

topmake() {
    (cd build/top && HOMEBREW_PREFIX="$brew" "$make" -n MAKE=echo "$@" 2>&1)
}

# $1: what is checked, $2: the lines, $3...: what each line must contain
expect() {
    what=$1; lines=$2; shift 2
    if [ -z "$lines" ]; then echo "$what: no such line"; return; fi
    for word in "$@"; do
        if ! printf '%s\n' "$lines" | grep -qF -- "$word"; then
            echo "$what: no $word in"; printf '%s\n' "$lines"; return
        fi
    done
    echo "$what: ok"
}

out=$(topmake -o support -o src/IdrisPaths.idr idris2-exec)
expect "RefC build of the compiler" "$(printf '%s\n' "$out" | grep -e '--build idris2.ipkg')" \
    "IDRIS2_CG=\"refc\"" "CPPFLAGS=\"-I$brew/include\"" "LDFLAGS=\"-L$brew/lib\""

out=$(topmake testenv test retest test-installed)
expect "test runner" "$(printf '%s\n' "$out" | grep -e '^-C tests testbin' | sed -n 1p)" \
    "CPPFLAGS=-I$brew/include" "LDFLAGS=-L$brew/lib"
expect "test" "$(printf '%s\n' "$out" | grep -e '^-C tests only=' | sed -n 1p)" \
    "CPPFLAGS=-I$brew/include" "LDFLAGS=-L$brew/lib"
expect "retest" "$(printf '%s\n' "$out" | grep -e '^-C tests retest')" \
    "CPPFLAGS=-I$brew/include" "LDFLAGS=-L$brew/lib"
expect "test-installed runner" "$(printf '%s\n' "$out" | grep -e '^-C tests testbin' | sed -n '$p')" \
    "CPPFLAGS=-I$brew/include" "LDFLAGS=-L$brew/lib"
expect "test-installed" "$(printf '%s\n' "$out" | grep -e '^-C tests only=' | sed -n '$p')" \
    "CPPFLAGS=-I$brew/include" "LDFLAGS=-L$brew/lib"

rm -rf build
