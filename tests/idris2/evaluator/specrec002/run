. ../../../testutils.sh

# How many copies are made of each function of the module
idris2 --spec-interfaces --log specialise.declare:5 --dumpcases cases.txt -o tree Tree.idr \
  | sed -n 's/.*Specialising \(Tree\..*\) (\$resolved.*/\1/p' \
  | sort | uniq -c
./build/exec/tree
# Which functions of the module the copies call: only copies
grep '^_PE\.' cases.txt | grep -o 'Tree\.[A-Za-z0-9:]*' | sort -u
rm -f cases.txt
