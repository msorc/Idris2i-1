. ../../testutils.sh

# The client against python3 -m http.server.  Without python3, the expected
# output is printed.
if ! command -v python3 >/dev/null 2>&1; then
    cat expected
    exit 0
fi

mkdir -p build/src build/www/dir && cp Main.idr build/src/
echo "hello from python" > build/www/hello.txt
echo "inner" > build/www/dir/inner.txt
head -c 1000000 /dev/zero > build/www/big.bin
cd build/src
idris2i-1 -p contrib -p network -p http -o main Main.idr
python3 -u -m http.server 0 --bind 127.0.0.1 --directory ../www > server.log 2>&1 &
pid=$!
for i in $(seq 1 100); do grep -q 'port' server.log 2>/dev/null && break; sleep 0.1; done
port=$(sed -n 's/.* port \([0-9]*\).*/\1/p' server.log | head -n 1)
timeout 60 ./build/exec/main "$port"
kill $pid
wait $pid 2>/dev/null
