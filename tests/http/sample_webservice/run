. ../../testutils.sh

# Build the sample web service, drive it with the client of the library,
# and stop it with SIGINT.
mkdir -p build/sample build/client
cp ../../../samples/webservice/Main.idr ../../../samples/webservice/Todos.idr ../../../samples/webservice/webservice.ipkg build/sample/
cp Client.idr build/client/
(cd build/sample && idris2 --build webservice.ipkg | grep -v 'Building\|compiling')
(cd build/client && idris2 -p contrib -p network -p http -o client Client.idr)
build/sample/build/exec/webservice 0 > build/service.log 2>&1 &
pid=$!
for i in $(seq 1 100); do grep -q listening build/service.log && break; sleep 0.1; done
port=$(sed -n 's/listening on .*:\([0-9]*\)/\1/p' build/service.log)
timeout 60 build/client/build/exec/client "$port"
kill -INT $pid
wait $pid
echo "service exit: $?"
sed -e 's/ [0-9]*us$//' -e 's/on 127.0.0.1:[0-9]*/on 127.0.0.1:PORT/' build/service.log
