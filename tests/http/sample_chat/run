. ../../testutils.sh

# Build the chat sample, drive it with 200 connections (on 1 and on 4
# workers), and stop it with SIGINT.
mkdir -p build/sample build/client
cp ../../../samples/chat/Main.idr ../../../samples/chat/chat.ipkg build/sample/
cp Client.idr build/client/
(cd build/sample && idris2i-1 --build chat.ipkg | grep -v 'Building\|compiling')
(cd build/client && idris2i-1 -p contrib -p network -p http -o client Client.idr)
for w in 1 4; do
    echo "=== $w workers"
    IDRIS2I_1_WORKERS=$w build/sample/build/exec/chat 0 > build/chat.log 2>&1 &
    pid=$!
    for i in $(seq 1 100); do grep -q listening build/chat.log && break; sleep 0.1; done
    port=$(sed -n 's/listening on .*:\([0-9]*\)/\1/p' build/chat.log)
    timeout 120 build/client/build/exec/client "$port" > build/client.log 2>&1 &
    cpid=$!
    for i in $(seq 1 1200); do grep -q waiting build/client.log && break; sleep 0.1; done
    kill -INT $pid
    wait $cpid
    wait $pid
    echo "chat exit: $?"
    cat build/client.log
    sed -e 's/on 127.0.0.1:[0-9]*/on 127.0.0.1:PORT/' build/chat.log
done
