. ../../testutils.sh

# curl over HTTP/2 with prior knowledge.  Without curl, or with a curl
# without HTTP/2, the expected output is printed.
if ! command -v curl >/dev/null 2>&1 || ! curl --version | grep -q 'HTTP2'; then
    cat expected
    exit 0
fi

mkdir -p build/src && cp Main.idr build/src/ && cd build/src
idris2i_1 -p contrib -p network -p http -o main Main.idr
rm -f port
./build/exec/main &
pid=$!
for i in $(seq 1 100); do [ -s port ] && break; sleep 0.1; done
base="http://127.0.0.1:$(cat port)"
c() { curl -sS --http2-prior-knowledge --max-time 10 "$@"; }
show() { tr -d '\r' | grep -v '^date: '; }

echo "--- GET"
c -i "$base/hello" 2>&1 | show
echo "--- HEAD"
c -I "$base/hello" 2>&1 | show
echo "--- POST"
c -d 'name=idris&kind=language' "$base/echo" 2>&1 | show
echo "--- upload"
seq -s, 1 20000 > upload.txt
c --data-binary @upload.txt "$base/echo" 2>&1 | show
echo "--- 5 MB download"
c "$base/big" | md5sum | cut -d' ' -f1
awk 'BEGIN { for (i = 0; i < 50; i++) { s = sprintf("%c", 65 + i % 26); for (j = 0; j < 100000; j++) printf "%s", s } }' | md5sum | cut -d' ' -f1
echo "--- three URLs, connections made for each"
c -w '%{num_connects} %{http_version}\n' -o /dev/null -o /dev/null -o /dev/null "$base/hello" "$base/second" "$base/hello"
echo "--- several at once"
c --parallel --parallel-immediate -w '%{http_code} %{http_version}\n' -o /dev/null -o /dev/null -o /dev/null -o /dev/null "$base/hello" "$base/second" "$base/big" "$base/hello"  | sort
echo "--- not found and wrong method"
c -o /dev/null -w '%{http_code}\n' "$base/nothing"
c -o /dev/null -w '%{http_code}\n' -X DELETE "$base/hello"
c "$base/quit"
wait $pid
echo "server exit: $?"
