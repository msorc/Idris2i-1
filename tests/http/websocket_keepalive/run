. ../../testutils.sh

mkdir -p build/src && cp ../common/HttpTest.idr ../common/WsTest.idr Main.idr build/src/ && cd build/src
idris2i-1 -p contrib -p network -p http -o main Main.idr
IDRIS2I_1_WORKERS=1 timeout 60 ./build/exec/main
echo "=== 4 workers"
IDRIS2I_1_WORKERS=4 timeout 60 ./build/exec/main > output.4
IDRIS2I_1_WORKERS=1 timeout 60 ./build/exec/main > output.1
if cmp -s output.1 output.4; then echo "same output"; else echo "different output"; diff output.1 output.4; fi
