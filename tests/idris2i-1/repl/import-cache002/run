. ../../../testutils.sh

# The REPL keeps the TTC files it reads for the next load: after a module
# changes, whether this process or another one builds it again, the next
# load must see the new version.
export IDRIS2I_1_BUILD_JOBS=1
export IDRIS2I_1_UNDER_TEST="$1"

cp Dep1.idr Dep.idr
idris2i_1 Main.idr < input

rm -f Dep.idr
