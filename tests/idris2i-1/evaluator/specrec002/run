. ../../../testutils.sh

# How many copies are made of each function of the module
idris2i_1 --spec-interfaces --log specialise.declare:5 --dumpcases cases.txt -o tree Tree.idr \
  | sed -n 's/.*Specialising \(Tree\..*\) (\$resolved.*/\1/p' \
  | sort | uniq -c
./build/exec/tree
# Which functions of the module the copies call: only copies
# (not the copies, which are in the namespace _PE.Tree)
grep '^_PE\.' cases.txt | sed 's/_PE\.Tree\.PE_[A-Za-z0-9_]*//g' | grep -o 'Tree\.[A-Za-z0-9:]*' | sort -u
rm -f cases.txt
