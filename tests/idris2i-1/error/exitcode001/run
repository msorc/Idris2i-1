. ../../../testutils.sh

# Every failure exits with a failure code, and success with 0.  (The
# messages are left out: other tests check them.)
code() {
  echo "--- $*"
  idris2i_1_no_clean "$@" > /dev/null 2>&1
  echo "exit code: $?"
}

code --check Ok.idr
code --check Missing.idr
code --check Missing.idr --error-format json
code --check Mismatch.idr
code --check Parse.idr
code -o ok Ok.idr
code -o ok Missing.idr
code -o nomain NoMain.idr
code --exec main Ok.idr
code --exec main Missing.idr
code --exec nope Ok.idr
code --exec main NoMain.idr
code --build Missing.ipkg
code Ok.idr --client ':t main'
code Ok.idr --client ':t nope'
code Ok.idr --client ':nocommand'
code Ok.idr --client ':l Missing.idr'
code Missing.idr --client ':t 1'

rm -rf build
