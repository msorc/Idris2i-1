. ../../../testutils.sh

# `--exec` exits with the exit code of the program, 128 + the signal when it
# is killed by one; `:exec` at the REPL says what the code is when it is not
# 0, and goes on.  With the default backend (RefC); tests/chez/exitcode001
# checks the same with Chez.
code() {
  echo "--- $*"
  idris2i_1_no_clean "$@"
  echo "exit code: $?"
}

code --exec ok Exit.idr
code --exec three Exit.idr
code --exec failure Exit.idr
code --exec crash Exit.idr
code --exec terminated Exit.idr
code --exec three --exec ok Exit.idr

idris2i-1 Exit.idr < input

rm -rf build
