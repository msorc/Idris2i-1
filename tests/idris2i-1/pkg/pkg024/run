. ../../../testutils.sh

# The modules of a package are built by several processes (--jobs, or
# IDRIS2I_1_BUILD_JOBS).  Left and Right import Base, and Top imports them: Left
# and Right are built at the same time once Base is built, and Top once they
# are built.  The modules that the longest chains of others wait for are
# started first, whatever their number in the build order.

rm -rf work
cp -r src work
sed 's/"src"/"work"/' diamond.ipkg > work.ipkg

build() {
  idris2i_1_no_clean --build work.ipkg "$@" > build.log 2>&1
  echo "exit code $?"
  cat build.log
}

ttcs() {
  for m in Base Left Right Top Extra; do
    if [ -e build/ttc/*/$m.ttc ]; then echo "$m.ttc"; fi
  done
}

echo "--- in parallel"
build --jobs 4
ttcs

echo "--- nothing to build"
build --jobs 4

# (Top is not started again: the interface of Right is the same)
echo "--- one module changed"
sed -i.bak 's/thrice c = /thrice c = id $ /' work/Right.idr
build --jobs 4

echo "--- an error in a module that is built at the same time as another"
rm -rf build
sed -i.bak 's/twice c = next (next c)/twice c = next (next c) c/' work/Left.idr
IDRIS2I_1_BUILD_JOBS=4 build
ttcs

echo "--- one process"
rm -rf build
mv work/Left.idr.bak work/Left.idr
build --jobs 1

rm -rf work work.ipkg build.log build
