. ../../../testutils.sh

mkdir prefix

IDRIS2I_1_PREFIX="$test_dir/prefix" idris2i_1 --install-with-src a1/a1.ipkg > /dev/null
IDRIS2I_1_PREFIX="$test_dir/prefix" idris2i_1 --install-with-src a2/a2.ipkg > /dev/null

IDRIS2I_1_PREFIX="$test_dir/prefix" idris2i_1 --no-prelude --ide-mode  < input1 \
  | grep -v ":highlight-source" | cut -c 7- | filter_test_dir | clean_version
IDRIS2I_1_PREFIX="$test_dir/prefix" idris2i_1 --no-prelude --ide-mode  < input2 \
  | grep -v ":highlight-source" | cut -c 7- | filter_test_dir | clean_version

rm -r a1/build a2/build b1/build b2/build
rm -rf prefix
