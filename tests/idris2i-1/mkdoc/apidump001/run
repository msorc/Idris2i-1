. ../../../testutils.sh

# The API of the fixture package
idris2i_1_no_clean --dump-api apifix.ipkg > build-a.api
cat build-a.api

# Byte-identical output from a second, clean build of the same source, from
# another directory (another absolute path) with the modules listed in another
# order (another build order)
rm -rf build
mkdir -p copy/elsewhere
cp -r src copy/elsewhere/
sed -e 's/^modules = .*/modules = ApiFix.Reexport, ApiFix.Shapes, ApiFix.Basic/' \
  apifix.ipkg > copy/elsewhere/apifix.ipkg
(cd copy/elsewhere && idris2i_1_no_clean --dump-api apifix.ipkg) > build-b.api
if cmp -s build-a.api build-b.api; then
  echo "same output from the second build"
else
  echo "different output from the second build:"
  diff -u build-a.api build-b.api
fi

# A build error: the errors, and a failure
mkdir -p copy/broken/src
printf 'module Broken\n\nexport\nx : Nat\nx = "no"\n' > copy/broken/src/Broken.idr
printf 'package broken\nsourcedir = "src"\nmodules = Broken\n' > copy/broken/broken.ipkg
(cd copy/broken && idris2i_1_no_clean --dump-api broken.ipkg; echo "exit status $?")

rm -rf build copy build-a.api build-b.api
