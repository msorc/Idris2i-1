# The run-time versions of the Nat functions (%transform rules to Integer)
# on each backend: RefC (the default), Chez and Node.
run Runtime.idr
idris2i-1 --cg chez -o runtime-chez Runtime.idr && ./build/exec/runtime-chez
idris2i-1 --cg node -o runtime.js Runtime.idr && node ./build/exec/runtime.js
